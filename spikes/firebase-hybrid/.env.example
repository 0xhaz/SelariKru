# Names only. Copy to .env.local and fill in your own project's values; never commit them.
# The Firebase web config (H9 fix round 1: read from the env, never written in the source).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# reCAPTCHA v3 site key for App Check (public value, but kept out of git via .env.local).
# Never put an App Check debug token here; the debug token is generated in the browser console.
VITE_RECAPTCHA_SITE_KEY=
