{
  "name": "selarikru",
  "version": "0.0.0",
  "private": true,
  "description": "SelariKru: hybrid local/cloud coding-agent workspace",
  "license": "Apache-2.0",
  "packageManager": "pnpm@9.12.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=9.12.2 <10"
  },
  "scripts": {
    "start": "node infra/start.mjs",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down -v",
    "dev:stack": "node infra/dev-stack.mjs",
    "dev:demo": "node infra/dev-demo.mjs",
    "dev:real": "node infra/dev-real.mjs",
    "check:hosted": "pnpm --filter @selarikru/control-web build:hosted && node tools/deploy/check-hosted.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
