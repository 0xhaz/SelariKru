# Names only. Copy to .env.local. Never commit values.
# VITE_RECAPTCHA_SITE_KEY: the reCAPTCHA Enterprise site key for App Check. Without it, App Check is not initialized. The hosted demo build (build:hosted) fails without it.
VITE_RECAPTCHA_SITE_KEY=
# Firebase web config (H9). Required: VITE_FIREBASE_API_KEY, VITE_FIREBASE_AUTH_DOMAIN, VITE_FIREBASE_PROJECT_ID, VITE_FIREBASE_STORAGE_BUCKET,
# VITE_FIREBASE_MESSAGING_SENDER_ID, VITE_FIREBASE_APP_ID. Read at build time; every production build (build, build:hosted) fails without them, and dev
# (dev:stack, dev:real) shows a notice that AI calls will fail. Dev ?demo needs none.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Control API origin (pnpm dev:stack serves it on http://127.0.0.1:8787).
VITE_API_BASE_URL=
# Firebase Auth Emulator origin, for example http://127.0.0.1:9099. Used in dev only; hosted builds ignore it.
VITE_AUTH_EMULATOR_URL=
# Optional prefill for the workflow target.
VITE_DEFAULT_PROJECT_ID=
VITE_DEFAULT_RUN_ID=
# Set by pnpm dev:demo; take precedence over the two defaults above.
VITE_DEMO_PROJECT_ID=
VITE_DEMO_RUN_ID=
