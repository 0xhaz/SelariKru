# Names only. Copy to .env.local. Never commit values.
# reCAPTCHA Enterprise site key for App Check. Without it, App Check is not initialized.
VITE_RECAPTCHA_SITE_KEY=
# Control API origin (pnpm dev:stack serves it on http://127.0.0.1:8787).
VITE_API_BASE_URL=
# Firebase Auth Emulator origin, for example http://127.0.0.1:9099. Used in dev only; hosted builds ignore it.
VITE_AUTH_EMULATOR_URL=
# Optional prefill for the workflow target.
VITE_DEFAULT_PROJECT_ID=
VITE_DEFAULT_RUN_ID=
