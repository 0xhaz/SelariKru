{
  "version": "0.1",
  "dataClassification": "synthetic_cloud_permitted",
  "systemInstruction": "Draft a concise summary and 1–8 testable acceptance criteria using only the supplied scope. Return JSON matching the schema. Use the supplied requirement IDs. Do not add mandatory integrations, accounts or new features.",
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "summary",
      "acceptanceCriteria"
    ],
    "properties": {
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "acceptanceCriteria": {
        "type": "array",
        "minItems": 1,
        "maxItems": 8,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "requirementId",
            "text"
          ],
          "properties": {
            "requirementId": {
              "type": "string",
              "enum": [
                "FB-01",
                "FB-02",
                "FB-03",
                "FB-04",
                "FB-05",
                "FB-06",
                "FB-07",
                "FB-08"
              ]
            },
            "text": {
              "type": "string",
              "minLength": 1,
              "maxLength": 400
            }
          }
        }
      }
    }
  },
  "fixtures": [
    {
      "id": "brief-01",
      "prompt": "Draft criteria for submitting feedback. Require a trimmed title of 3–120 Unicode code points and an optional description of at most 1,000 code points.",
      "allowedRequirementIds": [
        "FB-01",
        "FB-02"
      ],
      "humanReviewFacts": [
        "title bounds retained",
        "optional description retained",
        "validation does not save invalid input"
      ],
      "forbiddenMandatoryScope": [
        "login",
        "payments",
        "external database account",
        "production deployment"
      ]
    },
    {
      "id": "brief-02",
      "prompt": "Draft criteria for the feedback status flow: new items are Open; a user can switch to Planned or Done and reload without losing the status.",
      "allowedRequirementIds": [
        "FB-04",
        "FB-06"
      ],
      "humanReviewFacts": [
        "default Open",
        "exact three statuses",
        "persisted status"
      ],
      "forbiddenMandatoryScope": [
        "login",
        "payments",
        "external database account",
        "production deployment"
      ]
    },
    {
      "id": "brief-03",
      "prompt": "Draft criteria for All/Open/Planned/Done filters. Counts describe the complete dataset even while one status is selected.",
      "allowedRequirementIds": [
        "FB-05"
      ],
      "humanReviewFacts": [
        "four filters",
        "global counts",
        "updates reflected"
      ],
      "forbiddenMandatoryScope": [
        "login",
        "payments",
        "external database account",
        "production deployment"
      ]
    },
    {
      "id": "brief-04",
      "prompt": "Draft criteria for storing feedback in the local demo database so reload and API restart preserve submitted data.",
      "allowedRequirementIds": [
        "FB-06"
      ],
      "humanReviewFacts": [
        "reload persistence",
        "restart persistence",
        "same per-run database"
      ],
      "forbiddenMandatoryScope": [
        "login",
        "payments",
        "external database account",
        "production deployment"
      ]
    },
    {
      "id": "brief-05",
      "prompt": "Draft criteria for loading, empty and failed-request states. A failed save must not look successful.",
      "allowedRequirementIds": [
        "FB-07"
