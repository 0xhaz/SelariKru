{
  "name": "@selarikru/control-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SelariKru control API: authenticated owner and runner HTTP surface over the domain, policy, persistence and scheduler packages.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./test-helpers": "./test/helpers.ts"
  },
  "scripts": {
    "start": "tsx src/main.ts",
    "migrate": "tsx src/migrate.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@selarikru/domain": "workspace:*",
    "@selarikru/persistence": "workspace:*",
    "@selarikru/policy": "workspace:*",
    "@selarikru/protocol": "workspace:*",
    "@selarikru/workflow": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "firebase-admin": "14.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
