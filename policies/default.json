{
  "policyVersion": "2026-11-09.1",
  "operations": {
    "read_approved_docs": "allow",
    "run_scoped_tests": "allow",
    "edit_scoped_dev_branch": "allow",
    "create_draft_pr": "allow",
    "append_artifacts": "allow",
    "assign_replan_tasks": "allow",
    "assign_model": "allow",
    "destructive_data_migration": "require_approval",
    "modify_org_permissions": "deny",
    "new_domain": "require_approval",
    "new_connector": "require_approval",
    "broader_scope": "require_approval",
    "breaking_api_change": "require_approval",
    "scope_change": "require_approval",
    "budget_increase": "require_approval",
    "production_data": "deny",
    "production_infrastructure": "deny",
    "deploy": "deny",
    "merge_protected_branch": "deny",
    "modify_policy": "deny",
    "modify_credentials": "deny"
  },
  "limits": {
    "maxConcurrentTotal": 2,
    "maxIntegrationWorkers": 1,
    "maxBrowserGenerations": 1,
    "repairAttempts": 2,
    "attemptTimeoutSeconds": 1800
  },
  "models": {
    "allowed": [
      { "provider": "anthropic", "model": "claude-sonnet-5-5" },
      { "provider": "anthropic", "model": "claude-opus-5-5" },
      { "provider": "anthropic", "model": "claude-haiku-5-5" }
    ],
    "default": { "provider": "anthropic", "model": "claude-sonnet-5-5" }
  },
  "destinations": [],
  "selectedSources": []
}
