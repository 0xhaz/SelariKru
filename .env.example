# Names only. Never commit values. Copy to .env locally.
DATABASE_URL=
TEST_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_APPCHECK_SITE_KEY=

# Control web (apps/control-web). The Firebase web config, read at build time. A production build fails without them; dev (?demo) needs none.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# App Check (reCAPTCHA Enterprise) site key. Required by the hosted demo build (build:hosted). Never set an App Check debug token for a hosted build.
VITE_RECAPTCHA_SITE_KEY=

# Control API (apps/control-api). Every limit is required; the API refuses to start without one.
SELARIKRU_MODE=
SELARIKRU_API_HOST=
SELARIKRU_API_PORT=
SELARIKRU_TENANT_ID=
SELARIKRU_OWNER_UID=
SELARIKRU_ALLOWED_ORIGINS=
SELARIKRU_POLICY_FILE=
# JSON file of per-project plan settings for proposal review. Without it, review is blocked.
SELARIKRU_PLAN_CONFIG_FILE=
# Optional. Lifetime of a draft reclassification grant in seconds (default 86400).
SELARIKRU_RECLASSIFICATION_GRANT_TTL_SECONDS=
SELARIKRU_MAX_CONCURRENT_TOTAL=
SELARIKRU_ATTEMPT_TIMEOUT_SECONDS=
SELARIKRU_MAX_INFRA_RETRIES=
SELARIKRU_INFRA_RETRY_BACKOFF_SECONDS=
SELARIKRU_INFRA_RETRY_BACKOFF_MAX_SECONDS=
SELARIKRU_PAIRING_CODE_TTL_SECONDS=
SELARIKRU_EXPIRE_LEASES_INTERVAL_MS=

# Local development only (pnpm dev:stack). Never set in a hosted deployment.
FIREBASE_AUTH_EMULATOR_HOST=
SELARIKRU_AUTH_EMULATOR_PORT=

# Real run (pnpm dev:real). Placeholders only; set real values in your local .env.
SELARIKRU_SOURCE_REPO=/absolute/path/to/source-checkout
# Opening a draft pull request needs 1. Leave unset or 0 to keep GitHub off.
# With 1, main's tip is read from GitHub and fetched into SELARIKRU_SOURCE_REPO before a candidate is built, so the
# checkout needs fetch access to the repository. With 0, the local branch of SELARIKRU_SOURCE_REPO is main.
SELARIKRU_GITHUB_ENABLED=0
SELARIKRU_REAL_REPOSITORY=owner/repo
SELARIKRU_REAL_ALLOWED_PATHS=src,public
SELARIKRU_REAL_BUDGET_LIMIT_USD=5
SELARIKRU_REAL_BASE_BRANCH=main
SELARIKRU_REAL_PROJECT_ID=proj_real_local
SELARIKRU_REAL_RUN_ID=run_real_local
# Auth Emulator owner account the seed creates (emulator only).
SELARIKRU_REAL_OWNER_EMAIL=owner@selarikru.invalid
SELARIKRU_REAL_OWNER_PASSWORD=
