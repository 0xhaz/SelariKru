# Names only. Never commit values. Copy to .env locally.
DATABASE_URL=
TEST_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_APPCHECK_SITE_KEY=

# Control API (apps/control-api). Every limit is required; the API refuses to start without one.
SELARIKRU_MODE=
SELARIKRU_API_HOST=
SELARIKRU_API_PORT=
SELARIKRU_TENANT_ID=
SELARIKRU_OWNER_UID=
SELARIKRU_ALLOWED_ORIGINS=
SELARIKRU_POLICY_FILE=
SELARIKRU_MAX_CONCURRENT_TOTAL=
SELARIKRU_ATTEMPT_TIMEOUT_SECONDS=
SELARIKRU_MAX_INFRA_RETRIES=
SELARIKRU_INFRA_RETRY_BACKOFF_SECONDS=
SELARIKRU_INFRA_RETRY_BACKOFF_MAX_SECONDS=
SELARIKRU_PAIRING_CODE_TTL_SECONDS=
SELARIKRU_EXPIRE_LEASES_INTERVAL_MS=

# Local development only (pnpm dev:stack). Never set in a hosted deployment.
FIREBASE_AUTH_EMULATOR_HOST=
SELARIKRU_AUTH_EMULATOR_PORT=
