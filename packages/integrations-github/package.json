{
  "name": "@selarikru/integrations-github",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub review and reconciliation: pushes a verified candidate to a branch, opens a draft PR, and records a merge only after an authoritative read. Nothing here can merge.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./testing": "./src/fake.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@selarikru/domain": "workspace:*",
    "@selarikru/persistence": "workspace:*",
    "@selarikru/protocol": "workspace:*",
    "@selarikru/workflow": "workspace:*",
    "drizzle-orm": "0.45.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
