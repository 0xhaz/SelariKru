{
  "name": "@selarikru/runtime-docker-local",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RuntimeAdapter over the Docker Sandboxes `sbx` CLI (local only), plus task bundle building and post-run diff checks. The sbx command runner is injected.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./fake-sbx": "./src/fake-sbx.ts" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@selarikru/harness-claude": "workspace:*",
    "@selarikru/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
